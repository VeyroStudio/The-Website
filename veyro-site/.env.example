# ---------------------------------------------------------------
# VEYRO — environment
# Copy this file to `.env.local` and fill in the values.
# .env.local is git-ignored; never commit real keys.
# ---------------------------------------------------------------

# Where enquiries are delivered.
#
# IMPORTANT: both providers below send to whichever inbox the key or form
# was registered under. The site already puts ethan@veyrostudio.co.uk in
# the payload, but that does NOT override the provider's own routing — you
# must sign up using ethan@veyrostudio.co.uk for enquiries to land there.
#
# Option A — Web3Forms (free, no account, quickest)
#   1. Go to https://web3forms.com
#   2. Enter ethan@veyrostudio.co.uk and submit
#   3. Paste the access key that arrives below, and uncomment both lines
# NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
# NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here
#
# Option B — Formspree (dashboard, spam filtering, submission history)
#   1. Create an account with ethan@veyrostudio.co.uk at https://formspree.io
#   2. Create a form, paste its endpoint below, leave the Web3Forms key blank
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_WEB3FORMS_KEY=
